---
import Layout from '../layouts/Layout.astro'
---
<Layout title="作品 · 张甜湉" description="简历×岗位匹配实验：粘贴 JD + 两份简历，自动算匹配度。">
  <div class="page">
    <div class="page-head">
      <p class="page-kicker mono">WORKS · FLAGSHIP CASE + GALLERY</p>
      <h1 class="page-title">作品</h1>
      <p class="page-lead">几件能代表我怎么思考、怎么做事的东西——方法、研究，和一件自己做的网页。</p>
    </div>

    <!-- ── 旗舰案例：可跑的简历 × JD 匹配实验台 ────────────────── -->
    <div class="block">
      <h2>旗舰案例 · 简历 × 岗位匹配实验台</h2>
      <div class="hud hud-flagship">
        <div class="flagship-head">
          <span class="mono fh-tag">// CASE 001 · FLAGSHIP · LIVE</span>
          <span class="mono fh-stat">粘贴 JD + 两份简历 → 自动跑匹配 · 实时出分</span>
        </div>
        <p class="flagship-lead">
          把 <strong>岗位 JD</strong> 和两份定位不同的简历贴进来，<strong>点 RUN</strong>。终端会跑出关键词提取 / 双向覆盖 / 双份对比的过程，最后给两份匹配度。<strong>同一份人，两种材料呈现，分数会差多少——这是这个实验台想让你看到的事。</strong>
        </p>

        <!-- 输入面板 -->
        <div class="lab-input">
          <div class="lab-row">
            <label class="lab-label mono">// JD</label>
            <textarea id="jdText" class="lab-ta" rows="4" placeholder="岗位 JD 文本..."></textarea>
          </div>
          <div class="lab-row2">
            <div class="lab-cell">
              <label class="lab-label mono">// RESUME A</label>
              <textarea id="resumeA" class="lab-ta" rows="6" placeholder="简历 A 文本..."></textarea>
            </div>
            <div class="lab-cell">
              <label class="lab-label mono">// RESUME B</label>
              <textarea id="resumeB" class="lab-ta" rows="6" placeholder="简历 B 文本..."></textarea>
            </div>
          </div>
          <div class="lab-actions">
            <button class="btn btn-pink" id="runBtn">▶ RUN 跑一次</button>
            <button class="btn btn-ghost" id="fillSampleBtn">↻ 载入示例</button>
            <button class="btn btn-ghost" id="clearBtn">⌫ 清空</button>
            <span class="lab-hint mono">// 用浏览器跑，不上传</span>
          </div>
        </div>

        <!-- 终端输出 -->
        <div class="terminal" id="terminal">
          <div class="term-head">
            <span class="term-dot dot-r"></span>
            <span class="term-dot dot-y"></span>
            <span class="term-dot dot-g"></span>
            <span class="term-title mono">tt-skill:job-fit · v1.0</span>
          </div>
          <div class="term-body" id="termBody">
            <div class="term-line dim"># 等待 RUN …（把 JD 和两份简历粘贴到上方输入框）</div>
          </div>
        </div>

        <!-- 结果条 -->
        <div class="vs-stage" id="vsStage" style="display:none">
          <div class="vs-card vs-card-a">
            <span class="vc-label mono">RESUME A</span>
            <div class="vc-num num-display glow-pink" id="scoreA">0</div>
            <span class="vc-cap mono">JOB FIT %</span>
            <div class="vc-meta">
              <span class="tag tag-warm">命中 <span id="hitA">0</span> 词</span>
              <span class="tag">覆盖 <span id="covA">0</span>%</span>
            </div>
          </div>
          <div class="vs-mid">
            <span class="vs-delta mono glow-warm" id="deltaLabel">—</span>
            <span class="vs-sub mono">same person · different framing</span>
          </div>
          <div class="vs-card vs-card-b">
            <span class="vc-label mono">RESUME B</span>
            <div class="vc-num num-display" id="scoreB" style="color:var(--ink-soft);text-shadow:0 0 14px rgba(183,171,196,.35)">0</div>
            <span class="vc-cap mono">JOB FIT %</span>
            <div class="vc-meta">
              <span class="tag tag-cyan">命中 <span id="hitB">0</span> 词</span>
              <span class="tag">覆盖 <span id="covB">0</span>%</span>
            </div>
          </div>
        </div>

        <!-- 关键词对比 -->
        <div class="kw-compare" id="kwCompare" style="display:none">
          <div class="kw-block">
            <span class="kw-label mono">// A 命中关键词</span>
            <div class="kw-tags" id="kwA"></div>
          </div>
          <div class="kw-block">
            <span class="kw-label mono">// A 缺失关键词</span>
            <div class="kw-tags" id="kwMissA"></div>
          </div>
          <div class="kw-block">
            <span class="kw-label mono">// B 命中关键词</span>
            <div class="kw-tags" id="kwB"></div>
          </div>
          <div class="kw-block">
            <span class="kw-label mono">// B 缺失关键词</span>
            <div class="kw-tags" id="kwMissB"></div>
          </div>
        </div>

        <div class="quote flagship-quote">
          <strong>人没变，能力没变，只是材料呈现变了——匹配度就可能差一截。</strong>
          这件事逼我看见第一遍看不见的东西：<strong>拿到面试的是"材料呈现"，不是"真实能力"；而两者的差值，才是最该处理的清单。</strong>
        </div>
      </div>
    </div>

    <!-- ── 横向画廊：其他 3 件作品 ──────────────────────────────── -->
    <div class="block">
      <h2>其他作品 · GALLERY</h2>
      <p class="gallery-hint mono">← 横向滑动浏览 →</p>
      <div class="gallery-h">
        <article class="g-card">
          <div class="gc-cover gc-cover-1">
            <span class="gc-cover-num mono">01</span>
            <div class="gc-cover-deco"></div>
          </div>
          <div class="gc-body">
            <span class="gc-kicker mono">RESEARCH · 2026.08</span>
            <h3>实习招新对比研究</h3>
            <div class="gc-tags">
              <span class="tag tag-purple">财会类</span>
              <span class="tag tag-purple">采购运营类</span>
              <span class="tag tag-cyan">真实帖子</span>
              <span class="tag">6 维度</span>
            </div>
            <p>抓取两类实习的真实招新帖子，从岗位职责、能力要求、加分项、工作节奏、成长路径、门槛六个维度并排对比，帮"该投哪类岗"从感觉变成判断。</p>
          </div>
        </article>

        <article class="g-card">
          <div class="gc-cover gc-cover-2">
            <span class="gc-cover-num mono">02</span>
            <div class="gc-cover-deco"></div>
          </div>
          <div class="gc-body">
            <span class="gc-kicker mono">METHOD · v1.3</span>
            <h3>求职面试 AI 工作流 · SKILL</h3>
            <div class="gc-tags">
              <span class="tag tag-cyan">四阶段</span>
              <span class="tag tag-cyan">可复用</span>
              <span class="tag tag-purple">已落地</span>
            </div>
            <p>把"怎么分析岗位、怎么从经历里找证据、怎么调表达、怎么准备笔面"固化成一套能反复跑的方法。看到新岗位，把信息和素材放进去，再跑一次就行。</p>
          </div>
        </article>

        <article class="g-card">
          <div class="gc-cover gc-cover-3">
            <span class="gc-cover-num mono">03</span>
            <div class="gc-cover-deco"></div>
          </div>
          <div class="gc-body">
            <span class="gc-kicker mono">PAGE · 2026.08</span>
            <h3>个人说明书 · 交互落地页</h3>
            <div class="gc-tags">
              <span class="tag tag-warm">粉黑动漫风</span>
              <span class="tag tag-warm">可交互</span>
              <span class="tag">V6.0</span>
            </div>
            <p>把"如何与我合作"写成一张粉黑游戏风的交互网页：身份、任务、沟通、反馈、压力与支持系统，一页看全。也是我对"个人品牌该长什么样"的一次实操。</p>
          </div>
        </article>

        <article class="g-card">
          <div class="gc-cover gc-cover-4">
            <span class="gc-cover-num mono">04</span>
            <div class="gc-cover-deco"></div>
          </div>
          <div class="gc-body">
            <span class="gc-kicker mono">DATA · STATA 18</span>
            <h3>论文指标复刻 · 财务领域</h3>
            <div class="gc-tags">
              <span class="tag tag-purple">Stata</span>
              <span class="tag tag-purple">统一口径法</span>
              <span class="tag">E1/E2/E3</span>
            </div>
            <p>把已复刻到 T 年的论文指标，安全延伸到 T+n 年——冻结原版处理阈值，一次跑完整样本，与原文复现程度达 80% 以上。</p>
          </div>
        </article>
      </div>
    </div>

    <!-- ── 成就墙（4 个数据徽章） ──────────────────────────── -->
    <div class="block">
      <h2>成就墙 · ACHIEVEMENTS</h2>
      <div class="achv-grid">
        <div class="achv-badge">
          <div class="achv-icon mono glow-pink">★</div>
          <div class="achv-num num-display glow-pink">72</div>
          <div class="achv-cap mono">首次随机测试 %</div>
          <div class="achv-desc">JD &amp; 简历首次随机跑分 · 仅微调几个关键小词 · 55% → 72%</div>
        </div>
        <div class="achv-badge">
          <div class="achv-icon mono glow-cyan">✦</div>
          <div class="achv-num num-display glow-cyan">3000</div>
          <div class="achv-cap mono">条 / 月</div>
          <div class="achv-desc">VBA 自动化模型 · 把 1 周的人工压缩到 20 分钟</div>
        </div>
        <div class="achv-badge">
          <div class="achv-icon mono glow-purple">◆</div>
          <div class="achv-num num-display glow-purple">10+</div>
          <div class="achv-cap mono">省级以上</div>
          <div class="achv-desc">挑战杯 / 数学建模 / 英语竞赛 等 10 余项省级以上奖项</div>
        </div>
        <div class="achv-badge">
          <div class="achv-icon mono" style="color:var(--warm);text-shadow:0 0 16px rgba(255,193,120,.5)">∞</div>
          <div class="achv-num num-display" style="color:var(--warm);text-shadow:0 0 18px rgba(255,193,120,.5)">∞</div>
          <div class="achv-cap mono">好奇心</div>
          <div class="achv-desc">摄影 / 潜水 / 文学 / 街舞 — 一直想学新东西</div>
        </div>
      </div>
    </div>

  </div>

  <!-- 简历×JD 匹配实验台 · 算法 + 打字机输出 -->
  <script>
    // ── 工具函数 ──────────────────────────────────────────────
    const STOP = new Set('的 了 和 与 或 是 在 把 被 也 还 但 而 及 对 为 就 这 那 我 你 他 她 它 我们 他们 之 于 以 来 到 没 有 但 因 与 其 所 各 由'.split(/\s+/));
    function tokenize(text){
      if(!text) return [];
      const t = String(text).toLowerCase();
      const out = [];
      // 英文/数字 token
      const en = t.match(/[a-z0-9]+/g) || [];
      out.push(...en.filter(w => w.length>=2 && !STOP.has(w)));
      // 中文：先按标点切，再做 bigram + 2/3字词
      const zhParts = t.split(/[\s,，。.、；;：:！!？?\(\)\[\]\{\}【】《》·\/\\\n\t\r"'`~@#$%^&*+=|]/g).filter(Boolean);
      for(const seg of zhParts){
        // 中文字符
        const m = seg.match(/[\u4e00-\u9fff]+/g);
        if(!m) continue;
        for(const s of m){
          // 2字 + 3字词
          if(s.length>=2){
            for(let i=0;i<s.length-1;i++) out.push(s.substr(i,2));
          }
          if(s.length>=3){
            for(let i=0;i<s.length-2;i++) out.push(s.substr(i,3));
          }
        }
      }
      return out.filter(w => !STOP.has(w));
    }
    function countFreq(tokens){
      const m = new Map();
      for(const t of tokens) m.set(t,(m.get(t)||0)+1);
      return m;
    }
    function extractKeywords(text, topN=20){
      const freq = countFreq(tokenize(text));
      return [...freq.entries()].sort((a,b)=>b[1]-a[1]).slice(0,topN).map(([w,c])=>({w,c}));
    }
    function jaccard(a,b){
      const A=new Set(a),B=new Set(b);
      let inter=0; A.forEach(x=>{ if(B.has(x)) inter++; });
      const u = new Set([...A,...B]).size;
      return u ? inter/u : 0;
    }
    function coverage(jdSet, resumeSet){
      let hit=0; jdSet.forEach(x=>{ if(resumeSet.has(x)) hit++; });
      return jdSet.size ? hit/jdSet.size : 0;
    }

    // ── 评分：基础覆盖率 + 词频权重 + 高频词加权 ──────────────
    function scoreJD(jdText, resumeText){
      const jdKw = extractKeywords(jdText, 25);
      const reKw = extractKeywords(resumeText, 60);
      const jdSet = new Set(jdKw.map(x=>x.w));
      const reSet = new Set(reKw.map(x=>x.w));
      // 命中率 = 命中数 / jd 关键词数
      const hit = [];
      const miss = [];
      jdKw.forEach(({w,c})=>{
        if(reSet.has(w)) hit.push({w,c});
        else miss.push({w,c});
      });
      // 权重：高频 × 1.5, 低频 × 1.0; 总权重归一
      let totalW = 0, hitW = 0;
      jdKw.forEach(({c})=>{
        const w = c>=3 ? 1.5 : 1.0;
        totalW += w;
      });
      hit.forEach(({c})=>{ hitW += (c>=3?1.5:1.0); });
      const pct = totalW ? Math.round(hitW/totalW*100) : 0;
      return { pct, hit, miss, jdKw, reKw, coverage: jdSet.size ? Math.round(hit.length/jdSet.size*100) : 0 };
    }

    // ── 终端打字机 ──────────────────────────────────────────
    const term = document.getElementById('termBody');
    function termReset(){ term.innerHTML=''; }
    function termLine(text, cls='info', delay=60){
      return new Promise(r=>{
        setTimeout(()=>{
          const div = document.createElement('div');
          div.className = 'term-line '+cls;
          div.textContent = text;
          term.appendChild(div);
          term.scrollTop = term.scrollHeight;
          r();
        }, delay);
      });
    }
    async function termType(text, cls='info', charDelay=18){
      const div = document.createElement('div');
      div.className = 'term-line '+cls;
      term.appendChild(div);
      term.scrollTop = term.scrollHeight;
      for(let i=0;i<text.length;i++){
        div.textContent += text[i];
        if(i%3===0) term.scrollTop = term.scrollHeight;
        await new Promise(r=>setTimeout(r, charDelay));
      }
      return div;
    }

    // ── 主流程 ─────────────────────────────────────────────
    async function runLab(){
      const jd = document.getElementById('jdText').value.trim();
      const ra = document.getElementById('resumeA').value.trim();
      const rb = document.getElementById('resumeB').value.trim();
      if(!jd || !ra || !rb){
        await termLine('⚠ 输入不完整，需要 JD + 简历 A + 简历 B 三段文本。','warn',0);
        return;
      }
      termReset();
      document.getElementById('vsStage').style.display='none';
      document.getElementById('kwCompare').style.display='none';
      await termLine('▶ START 简历×JD 匹配实验 …','info',0);
      await termLine(`  JD 字符: ${jd.length}  简历A 字符: ${ra.length}  简历B 字符: ${rb.length}`,'dim',120);
      await termLine('  [1/4] 提取 JD 关键词 …','info',200);
      const jdKw = extractKeywords(jd, 25);
      await termLine(`  ✓ 提取到 ${jdKw.length} 个关键词（前 10）：${jdKw.slice(0,10).map(x=>x.w+'×'+x.c).join(' / ')}`,'pass',180);
      await termLine('  [2/4] 计算 RESUME A …','info',200);
      const rA = scoreJD(jd, ra);
      await termLine(`  ✓ A 命中 ${rA.hit.length}/${jdKw.length}，覆盖率 ${rA.coverage}% 加权得分 ${rA.pct}`,'pass',220);
      await termLine('  [3/4] 计算 RESUME B …','info',200);
      const rB = scoreJD(jd, rb);
      await termLine(`  ✓ B 命中 ${rB.hit.length}/${jdKw.length}，覆盖率 ${rB.coverage}% 加权得分 ${rB.pct}`,'pass',220);
      await termLine('  [4/4] 双份差值 …','info',200);
      const delta = rA.pct - rB.pct;
      await termLine(`  ✓ Δ = ${delta>0?'+':''}${delta} pts（${delta>0?'A 更贴合 JD':delta<0?'B 更贴合 JD':'两份相同'})`,'pass',180);
      await termLine('▶ DONE','info',220);

      // 渲染结果条（数字动画）
      document.getElementById('vsStage').style.display='';
      animateScore('scoreA', rA.pct);
      animateScore('scoreB', rB.pct);
      document.getElementById('hitA').textContent = rA.hit.length;
      document.getElementById('hitB').textContent = rB.hit.length;
      document.getElementById('covA').textContent = rA.coverage;
      document.getElementById('covB').textContent = rB.coverage;
      const dl = document.getElementById('deltaLabel');
      dl.textContent = (delta>0?'+':'') + delta + ' pts';
      dl.style.color = delta>0 ? 'var(--pink)' : (delta<0?'var(--purple)':'var(--ink-soft)');

      // 关键词清单
      document.getElementById('kwCompare').style.display='';
      renderKw('kwA', rA.hit.map(x=>x.w), 'pink');
      renderKw('kwMissA', rA.miss.map(x=>x.w), 'miss');
      renderKw('kwB', rB.hit.map(x=>x.w), 'cyan');
      renderKw('kwMissB', rB.miss.map(x=>x.w), 'miss');
    }
    function animateScore(id, target){
      const el = document.getElementById(id);
      const start = performance.now(); const dur=1100;
      const tick = (t)=>{
        const p = Math.min(1, (t-start)/dur);
        const e = 1-Math.pow(1-p,3);
        el.textContent = Math.round(target*e);
        if(p<1) requestAnimationFrame(tick); else el.textContent = target;
      };
      requestAnimationFrame(tick);
    }
    function renderKw(id, words, kind){
      const box = document.getElementById(id);
      box.innerHTML='';
      words.forEach(w=>{
        const span = document.createElement('span');
        span.className = 'kw-tag '+(kind==='miss'?'kw-miss':(kind==='pink'?'kw-pink':'kw-cyan'));
        span.textContent = w;
        box.appendChild(span);
      });
      if(!words.length){
        const span = document.createElement('span');
        span.className = 'kw-empty';
        span.textContent = '— 无 —';
        box.appendChild(span);
      }
    }

    // ── 示例数据（贴合真实场景） ─────────────────────────────
    const SAMPLE = {
      jd: `岗位：内容运营实习生\n\n岗位职责：\n1. 负责公众号/小红书日常内容运营，包括选题策划、文案撰写、排版与发布；\n2. 跟进用户增长指标（DAU、留存、转化），配合活动策划提升用户活跃；\n3. 收集整理用户反馈与运营数据，输出周报月报，用数据驱动内容优化；\n4. 跨部门协作，与产品、设计、市场协同推进内容项目落地。\n\n任职要求：\n- 文案能力强，文字有感染力；\n- 熟悉主流社交平台（小红书/抖音/B站）运营玩法；\n- 数据敏感，能用数据驱动决策；\n- 加分：英语流利、有个人公众号/自媒体运营经验。`,
      a: `张甜湉 · 内容运营向简历\n\n教育：财务管理硕士在读\n\n经历：\n- 校园公众号主笔，年度阅读量 10w+，策划"考研故事"系列内容，单篇最高 1.2w 阅读；\n- 小红书账号运营 6 个月，定位"审计实习日记"，粉丝从 0 到 2400，多篇笔记进入同城榜；\n- 参与品牌活动策划组，负责文案与现场执行，活动期间用户活跃提升 18%；\n- 跨部门协作：与产品/设计/市场联动完成 3 个内容项目，平均周更 4 篇；\n- 数据驱动：用 Excel + VBA 自动化处理 3000+ 条用户数据，输出周报。\n\n技能：文案 / 排版 / 公众号 / 小红书 / Excel / 数据分析 / 跨部门协作。`,
