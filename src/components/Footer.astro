---
const year = new Date().getFullYear()
---
<footer class="ft">
  <div class="ft-inner">
    <div class="ft-left">
      <span class="ft-brand mono">© {year} ZHANG · TIANTIAN</span>
      <span class="ft-sub">财务管理硕士 · AI 内容方向</span>
    </div>
    <div class="ft-links mono">
      <a href="mailto:zhangtiantianxyt@163.com">EMAIL</a>
      <a href="https://github.com/tiayanodrama" target="_blank" rel="noopener">GITHUB</a>
      <a href="/about">ABOUT</a>
      <a href="/works">WORKS</a>
    </div>
    <div class="ft-version mono">
      <span class="ft-led"></span>
      v7.0 · {year}
    </div>
  </div>
</footer>

<style>
.ft{
  margin-top:60px;
  border-top:1px solid var(--rule);
  padding:20px 28px;
  background:rgba(10,6,18,.6);
  backdrop-filter:blur(10px);
}
.ft-inner{
  display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:14px;
  font-size:12px;color:var(--ink-light);
  max-width:1180px;margin:0 auto;
}
.ft-left{display:flex;flex-direction:column;gap:2px}
.ft-brand{font-size:13px;color:var(--ink);letter-spacing:1px}
.ft-sub{font-size:11px;color:var(--ink-light)}
.ft-links{display:flex;gap:16px}
.ft-links a{
  color:var(--ink-soft);font-size:11px;letter-spacing:1.5px;
  transition:color .2s;
}
.ft-links a:hover{color:var(--pink);text-shadow:var(--glow-pink)}
.ft-version{
  display:flex;align-items:center;gap:6px;
  font-size:11px;color:var(--cyan);letter-spacing:1.5px;
  text-shadow:var(--glow-cyan);
}
.ft-led{
  width:6px;height:6px;border-radius:50%;background:var(--cyan);
  box-shadow:var(--glow-cyan);
  animation:pulse 2.4s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
</style>