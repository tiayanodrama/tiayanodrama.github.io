---
const links = [
  { href: '/', label: 'HOME', cn: '首页' },
  { href: '/about', label: 'ABOUT', cn: '关于我' },
  { href: '/works', label: 'WORKS', cn: '作品' },
  { href: '/method', label: 'METHOD', cn: 'AI 协作方法论' },
  { href: '/contact', label: 'CONTACT', cn: '联系' },
]
const path = Astro.url.pathname
---
<header class="nav">
  <a class="brand" href="/">
    <span class="brand-mark">TT</span>
    <span class="brand-sep">/</span>
    <span class="brand-name">张甜湉</span>
  </a>
  <nav class="nav-links">
    {links.map(l => (
      <a href={l.href} class:list={["nav-link", { active: path === l.href || (l.href !== '/' && path.startsWith(l.href)) }]}>
        <span class="nl-en">{l.label}</span>
        <span class="nl-cn">{l.cn}</span>
      </a>
    ))}
  </nav>
  <div class="nav-status mono">
    <span class="led"></span>
    <span class="led-text">ONLINE · 2026</span>
  </div>
</header>

<style>
.nav{
  position:sticky;top:0;z-index:40;
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 28px;
  background:rgba(10,6,18,.78);backdrop-filter:blur(14px) saturate(160%);
  border-bottom:1px solid var(--rule);
}
.brand{display:flex;align-items:baseline;gap:6px}
.brand-mark{
  font-family:var(--f-mono);font-weight:700;font-size:24px;
  color:var(--pink);letter-spacing:-1px;
  text-shadow:var(--glow-pink);
}
.brand-sep{color:var(--ink-light);font-family:var(--f-mono);font-size:18px}
.brand-name{font-family:var(--f-display);font-size:17px;color:var(--ink)}

.nav-links{display:flex;gap:6px}
.nav-link{
  position:relative;display:flex;flex-direction:column;align-items:center;
  padding:8px 14px;border-radius:6px;
  font-family:var(--f-mono);transition:all .2s;
  border:1px solid transparent;
}
.nl-en{font-size:11px;letter-spacing:2px;color:var(--ink-mid);font-weight:700}
.nl-cn{font-size:11px;color:var(--ink-light);margin-top:1px}
.nav-link:hover{border-color:var(--rule-2);background:rgba(255,77,141,.06)}
.nav-link:hover .nl-en{color:var(--pink-soft)}
.nav-link.active{
  background:linear-gradient(135deg,rgba(255,77,141,.18),rgba(160,76,255,.10));
  border-color:var(--pink);
  box-shadow:inset 0 0 18px rgba(255,77,141,.18),var(--glow-pink);
}
.nav-link.active .nl-en{color:var(--pink);text-shadow:var(--glow-pink)}
.nav-link.active::before{
  content:'';position:absolute;left:50%;bottom:-1px;transform:translateX(-50%);
  width:24px;height:2px;background:var(--pink);
  box-shadow:0 0 12px var(--pink);
}

.nav-status{display:flex;align-items:center;gap:8px;font-size:10px;color:var(--ink-mid);letter-spacing:1.5px}
.led{
  width:8px;height:8px;border-radius:50%;background:var(--cyan);
  box-shadow:var(--glow-cyan);
  animation:pulse 2s ease-in-out infinite;
}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.6;transform:scale(.85)}}
.led-text{color:var(--cyan-soft,#9afce0)}

@media(max-width:768px){
  .nav{padding:12px 16px}
  .nav-link{padding:6px 8px}
  .nl-cn{display:none}
  .nl-en{font-size:10px}
  .brand-name{display:none}
  .nav-status{display:none}
}
</style>